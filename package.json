{
  "name": "@sunaissu/calculator",
  "version": "1.1.0",
  "description": "A safe engineering calculator for React with document and canvas insertion adapters.",
  "keywords": [
    "react",
    "calculator",
    "canvas",
    "document",
    "engineering",
    "calculus"
  ],
  "homepage": "https://github.com/sunaissu/calculator#readme",
  "bugs": {
    "url": "https://github.com/sunaissu/calculator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunaissu/calculator.git"
  },
  "license": "MIT",
  "author": "sunaissu",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE",
    "implementation-review.txt",
    "feature-backlog.txt"
  ],
  "scripts": {
    "build": "tsup ./src/index.tsx --format cjs,esm --dts --clean",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run check && npm run build && node --test",
    "playground": "npm --prefix playground run dev",
    "playground:build": "npm --prefix playground run build",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "sideEffects": [
    "*.css"
  ]
}
