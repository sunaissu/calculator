{
  "name": "@sunaissu/calculator",
  "version": "1.1.0-rc.2",
  "description": "A React calculator for expressions and numerical calculus, with adapters that insert results into documents and canvases.",
  "keywords": [
    "react",
    "calculator",
    "canvas",
    "document",
    "engineering",
    "calculus",
    "typescript",
    "react-component",
    "scientific-calculator",
    "numerical-calculus"
  ],
  "homepage": "https://github.com/sunaissu/calculator#readme",
  "bugs": {
    "url": "https://github.com/sunaissu/calculator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunaissu/calculator.git"
  },
  "license": "MIT",
  "author": "sunaissu",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE",
    "assets/brand/sunaissu.svg",
    "assets/brand/sora-OFL.txt",
    "assets/brand/SOURCE.txt"
  ],
  "scripts": {
    "build": "tsup ./src/index.tsx --format cjs,esm --dts --clean",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run check && npm run build && node --test",
    "playground": "npm --prefix playground run dev",
    "playground:build": "npm --prefix playground run build",
    "prepublishOnly": "npm test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "sideEffects": [
    "*.css"
  ]
}
